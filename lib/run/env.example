# Copy this file to `.env` (next to app_DB.py) and fill in real values.

# Session signing secret for login tokens. Set a long random string in
# production; if unset, a random one is generated per restart (sessions reset).
AUTH_SECRET=
# Login/register rate limit per client per minute
AUTH_RATE_LIMIT_PER_MINUTE=20

# OpenAI (required for /makeGPT)
OPENAI_API_KEY=

# MySQL (required for request logging)
DB_HOST=127.0.0.1
DB_USER=rescene
DB_PASSWORD=
DB_NAME=rescene
DB_CHARSET=utf8mb4

# Ollama chat endpoint (required for /submit_content)
OLLAMA_URL=http://localhost:11434/api/chat

# YOLO weights. Defaults to the pip-installed ultralytics lookup ("yolo11x-seg.pt").
# Point MODEL_PATH at a local .pt file if you keep weights elsewhere.
MODEL_PATH=yolo11x-seg.pt

# Optional: use a local ultralytics source checkout instead of the pip package.
# Leave empty when ultralytics is installed via pip.
ULTRALYTICS_PATH=

# Server bind address
HOST=127.0.0.1
PORT=5000

# --- Concurrency (all optional; defaults shown) ---
# Production WSGI server threads (waitress)
SERVER_THREADS=8
# Max simultaneous YOLO inferences (1 = serialized; safest for one GPU)
MAX_YOLO_CONCURRENCY=1
# Seconds a request may wait in the YOLO inference queue before 503
YOLO_QUEUE_TIMEOUT=120
# MySQL connection pool size (>= SERVER_THREADS recommended)
DB_POOL_SIZE=10
# Per-client-IP request limit per minute (general endpoints)
RATE_LIMIT_PER_MINUTE=120
# Per-client-IP /makeGPT limit per minute (protects OpenAI quota)
GPT_RATE_LIMIT_PER_MINUTE=10
# Waitress connection cap and channel timeout (s)
CONNECTION_LIMIT=100
CHANNEL_TIMEOUT=120
# Requests allowed to block waiting for a YOLO slot before 503. The wait queue
# is bounded so a burst cannot grow memory without limit.
YOLO_MAX_WAITERS=8
# Cross-process YOLO slot budget, for running several server instances on one
# host. Every instance sharing this file shares a single MAX_YOLO_CONCURRENCY
# budget, so N instances do not put N concurrent predictions on one GPU.
# Defaults to data/yolo_slots.lock next to app_DB.py; set it empty to disable
# cross-process limiting (single-instance deployments only). The limit only
# holds between processes that share a filesystem.
YOLO_SLOT_FILE=
# How often (s) a request waiting for a host-wide slot retries
YOLO_SLOT_POLL_INTERVAL=0.05
# MySQL pool contention: retries and linear backoff (s) before giving up as 503
DB_ACQUIRE_RETRIES=3
DB_ACQUIRE_BACKOFF=0.1
# Ollama proxy timeout (s)
OLLAMA_TIMEOUT=300
# OpenAI call budget: a stalled request must not pin a worker thread forever
OPENAI_TIMEOUT=180
OPENAI_MAX_RETRIES=1
# urllib3 pool size per worker thread for the Ollama proxy.
# Defaults to max(SERVER_THREADS, 10) when unset.
HTTP_POOL_SIZE=10

# --- Image retention (data/images) ---
# Generated images older than this are deleted (days)
IMAGE_RETENTION_DAYS=7
# Hard cap on retained image files; oldest are removed first
IMAGE_MAX_FILES=2000
# How often the cleanup pass runs (s)
IMAGE_CLEANUP_INTERVAL_S=600

# --- CORS (browser clients only) ---
# Comma-separated allowed origins, or * for any. Empty means no CORS headers
# at all, which is correct for the desktop and native clients. Only enable this
# (and prefer an explicit origin list) when serving the Expo web build.
CORS_ALLOW_ORIGINS=
